<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (U.14 c9): the system splash screen in the splash page's
         colour with the app's logo, no white circle (3.x: white with the
         launcher icon in a circle). Dark mode in values-night-v31. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <!-- Android 13+: the app's own light or dark ("主题模式"), chosen by
         MainActivity for the next cold start. -->
    <style name="SplashTheme.Light" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_light</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="SplashTheme.Dark" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
