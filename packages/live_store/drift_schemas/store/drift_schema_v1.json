  "fixed_sql": [
    {
      "name": "rooms",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rooms\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"platform\" TEXT NOT NULL, \"room_id\" TEXT NOT NULL, \"nick\" TEXT NOT NULL DEFAULT '', \"title\" TEXT NOT NULL DEFAULT '', \"avatar\" TEXT NULL, \"cover\" TEXT NULL, \"area\" TEXT NULL, \"user_id\" TEXT NULL, \"online_viewers\" INTEGER NULL, \"popularity\" INTEGER NULL, \"total_viewers\" INTEGER NULL, \"followers\" INTEGER NULL, \"last_status\" TEXT NULL, \"last_live_at\" INTEGER NULL, \"extra\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, UNIQUE (\"platform\", \"room_id\"));"
        }
      ]
    },
    {
      "name": "follows",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"follows\" (\"room\" INTEGER NOT NULL REFERENCES rooms (id) ON DELETE CASCADE, \"sort_order\" INTEGER NOT NULL, \"followed_at\" INTEGER NOT NULL, \"source\" TEXT NOT NULL DEFAULT 'user', PRIMARY KEY (\"room\"));"
        }
      ]
    },
    {
      "name": "follow_areas",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"follow_areas\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"platform\" TEXT NOT NULL, \"namespace\" TEXT NOT NULL DEFAULT '', \"area_id\" TEXT NOT NULL, \"area_name\" TEXT NOT NULL DEFAULT '', \"type_name\" TEXT NOT NULL DEFAULT '', \"area_pic\" TEXT NULL, \"short_name\" TEXT NULL, \"sort_order\" INTEGER NOT NULL, UNIQUE (\"platform\", \"namespace\", \"area_id\"));"
        }
      ]
    },
    {
      "name": "tags",
      "sql": [
