# Single source of truth for the toolchain. CI, tool/gate.sh, tools/check_latest
# and ~/tools/purelive-env.sh read these values. Update them only together with
# a verified toolchain upgrade.
FLUTTER_VERSION=3.47.5
DART_VERSION=3.13.4
GRADLE_VERSION=9.8.0
AGP_VERSION=9.4.1
# Kotlin comes with AGP's built-in Kotlin support.
KOTLIN_VERSION=2.2.10
JDK_FEATURE_VERSION=26
ANDROID_COMPILE_SDK=37
ANDROID_BUILD_TOOLS=37.0.0
# NDK used for the self-built native libraries (libmpv, FFmpeg).
ANDROID_NDK_VERSION=27.3.13750724
MPV_VERSION=0.41.0
FFMPEG_VERSION=9.0.2
# Self-maintained media_kit fork (ADR 0002): upstream repository and commit.
MEDIA_KIT_UPSTREAM_REPO=Predidit/media-kit
MEDIA_KIT_UPSTREAM_COMMIT=803c4a27912091db6f839d48d1b984a0d9f588c7
