        {"payload": {"result": 1, "cursor": "p2", "pullCycleSeconds": 0}},
        {"payload": {"result": 1, "cursor": "p3", "pullCycleSeconds": 30}},
        {"payload": {"result": 1, "cursor": "p4"}}
      ]
