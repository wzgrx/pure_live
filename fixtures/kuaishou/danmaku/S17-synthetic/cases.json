  "sessions": [
    {
      "name": "the first request succeeds",
      "steps": [
        {"payload": {"result": 1, "cursor": "a", "pullCycleSeconds": 3, "currentWatchingCount": "10", "liveStreamFeeds": [{"type": "comment", "content": "hello", "time": 1000, "author": {"userName": "viewer", "userId": 9}}]}}
      ]
    },
    {
      "name": "the fallback endpoint answers when the primary fails",
      "steps": [
        {"error": "connect"},
        {"payload": {"result": 1, "cursor": "b", "liveStreamFeeds": [{"type": "comment", "content": "from the fallback", "time": 1000, "author": {"userName": "v", "userId": 1}}]}}
      ]
    },
    {
      "name": "a 503 from the primary goes to the fallback",
      "steps": [
        {"status": 503},
        {"payload": {"result": 1, "cursor": "c"}}
      ]
    },
    {
      "name": "a body that is not JSON goes to the fallback",
      "steps": [
        {"raw": "<html>busy</html>"},
        {"payload": {"result": 1, "cursor": "d"}}
      ]
    },
    {
      "name": "the start tries again after 600 ms",
      "steps": [
        {"error": "connect"},
        {"error": "connect"},
        {"error": "timeout"},
        {"payload": {"result": 1, "cursor": "e", "currentWatchingCount": "3"}}
      ]
    },
    {
      "name": "a refusal is not retried on the fallback",
      "steps": [
        {"payload": {"result": 2}},
        {"payload": {"result": 2}},
        {"payload": {"result": 1, "cursor": "f"}}
      ]
    },
    {
      "name": "three failed starts throw the last failure",
      "steps": [
        {"error": "connect"},
        {"error": "connect"},
        {"error": "connect"},
        {"error": "connect"},
        {"error": "connect"},
        {"status": 502}
      ]
    },
    {
      "name": "three refused starts throw the refusal",
      "steps": [
        {"payload": {"result": 2}},
        {"payload": {"result": 2}},
        {"payload": {"result": 3}}
      ]
    },
    {
      "name": "a body that is not JSON goes to the fallback, an answer of the wrong shape does not",
      "steps": [
        {"raw": "<html>"},
        {"raw": "{"},
        {"payload": [1]},
        {"payload": "text"}
      ]
    },
    {
      "name": "polling gives up after the ninth failure in a row",
      "steps": [
        {"payload": {"result": 1, "cursor": "g", "pullCycleSeconds": 3, "currentWatchingCount": "5", "liveStreamFeeds": [{"type": "comment", "content": "only one", "time": 1000, "author": {"userName": "v", "userId": 1}}]}},
        {"error": "connect"}, {"error": "connect"},
        {"error": "connect"}, {"error": "connect"},
        {"error": "connect"}, {"error": "connect"},
        {"error": "connect"}, {"error": "connect"},
        {"error": "connect"}, {"error": "connect"},
        {"error": "connect"}, {"error": "connect"},
        {"error": "connect"}, {"error": "connect"},
        {"error": "connect"}, {"error": "connect"},
        {"error": "connect"}, {"error": "connect"}
      ]
    },
    {
      "name": "a success resets the failures and joins again",
      "steps": [
        {"payload": {"result": 1, "cursor": "h1", "currentWatchingCount": "7"}},
        {"error": "connect"}, {"error": "connect"},
        {"error": "connect"}, {"error": "connect"},
        {"payload": {"result": 1, "cursor": "h2", "currentWatchingCount": "8", "liveStreamFeeds": [{"type": "comment", "content": "back", "time": 5000, "author": {"userName": "v", "userId": 1}}]}},
        {"payload": {"result": 2}},
        {"payload": {"result": 1, "cursor": "h3"}}
      ]
    },
    {
      "name": "the cursor follows the answers and survives failures",
      "steps": [
        {"payload": {"result": 1, "cursor": "k1"}},
        {"payload": {"result": 1, "cursor": ""}},
        {"payload": {"result": 1}},
        {"error": "connect"}, {"error": "connect"},
        {"payload": {"result": 2, "cursor": "ignored"}},
        {"payload": {"result": 1, "cursor": "k2"}},
        {"payload": {"result": 1, "cursor": "k3"}}
      ]
    },
    {
      "name": "the server's pull cycle sets the next wait",
