<?xml version="1.0" encoding="utf-8"?>
<!-- Some platform CDNs still serve HTTP-FLV over plain HTTP, and the playback
     relay listens on loopback (docs/rewrite/PLAN.md §06). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
